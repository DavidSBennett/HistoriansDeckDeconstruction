{
  "name": "historians-deckbuilder",
  "private": true,
  "type": "module",
  "description": "The Historians deck-builder: rules engine, PHP polling backend and React client for projecta.thehistorians.org",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "data:extract": "node tools/extract-data.mjs",
    "data:check": "node tools/extract-data.mjs --check",
    "data:validate": "node tools/validate-data.mjs",
    "deck:import": "node tools/import-deck-csv.mjs",
    "sim": "node tools/simulate.mjs",
    "sim:mockup": "node tools/mockup-sim.mjs",
    "parity": "node tools/parity.mjs",
    "conformance": "node tools/record-conformance.mjs && php engine/php/tests/conformance.php",
    "lint:php": "node tools/lint-php.mjs",
    "test:backend": "node --test \"tests/backend/*.itest.mjs\""
  }
}
